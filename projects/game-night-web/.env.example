# Copy to .env.local for local dev; set the same names in Vercel → Settings → Environment Variables.

# Public URL of this app, no trailing slash. OAuth redirect URIs are built from it:
#   {APP_URL}/auth/patreon/callback   (register in the Patreon client)
#   {APP_URL}/auth/discord/callback   (register in the Discord application → OAuth2 → Redirects)
APP_URL=http://localhost:3000

# 32+ random characters. Signs the session cookie and encrypts stored Patreon tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Patreon → https://www.patreon.com/portal/registration/register-clients (create as the campaign owner)
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
# Optional. Only memberships of this campaign count. Find it with scripts/patreon-tiers.mjs.
PATREON_CAMPAIGN_ID=
# Tier price floors in cents (list price of the member's entitled tier).
PATREON_TIER_MEMBER_CENTS=500
PATREON_TIER_PRODUCER_CENTS=1200
PATREON_TIER_EXEC_CENTS=2500
PATREON_JOIN_URL=https://www.patreon.com/

# Discord → https://discord.com/developers/applications (the bot's application works)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=1042990295056396323
# Shown to members who link Discord but aren't in the server yet.
DISCORD_INVITE_URL=
# Comma-separated Discord user IDs with host/admin access.
ADMIN_DISCORD_IDS=

# Supabase (same project as the bot). Service role key is server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public values used by the browser for live updates on /play.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shared secret between the overlay (config.json → cloud.secret) and POST /api/ingest.
OVERLAY_INGEST_SECRET=

# Offseason label used for the one-seat-per-offseason rule and standings.
SEASON=2026-27
